FROM rocker/shiny:4.4.2

RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libjpeg-dev \
    libtiff-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/nyc311-venv \
    && /opt/nyc311-venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
RUN R -e "install.packages(c('shiny', 'plotly', 'forecast', 'arrow', 'reticulate'), repos='https://cloud.r-project.org')"
RUN rm -rf /srv/shiny-server/*

COPY src/app.R /srv/shiny-server/app.R
COPY src/forecasting.py /srv/shiny-server/forecasting.py
COPY src/workforce.py /srv/shiny-server/workforce.py
COPY data/dashboard_data.parquet /srv/shiny-server/dashboard_data.parquet
COPY shiny-server.conf /etc/shiny-server/shiny-server.conf

ENV RETICULATE_PYTHON=/opt/nyc311-venv/bin/python
RUN mkdir -p /home/shiny/.nyc311_pipeline \
    && chown -R shiny:shiny /srv/shiny-server /home/shiny/.nyc311_pipeline

EXPOSE 3838

CMD ["/usr/bin/shiny-server"]
